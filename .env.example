# HamiYami configuration. Copy to .env.local for local work; set real values in your host's
# dashboard for deployments. Never commit real values, and never prefix these with NEXT_PUBLIC_.
#
# With nothing set, the site runs as a public demo: no database, no real signup collection.

# --- Real waitlist collection (off by default) --------------------------------------------------
# Turning this on requires ALL of the variables below; the build fails with a clear message if
# any is missing. Leave it false until the Privacy Notice and the pilot checklist in README.md are
# done.
WAITLIST_COLLECTION_ENABLED=false

# Set to true only once a real Privacy Notice is published at /privacy.
PRIVACY_NOTICE_PUBLISHED=false

# Supabase project used to store signups (see supabase/schema.sql).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Server-side secret key (sb_secret_...). Never expose it to the browser.
SUPABASE_SECRET_KEY=replace-with-a-secret-key

# Origins allowed to post the form, comma-separated (e.g. https://your-domain.example).
WAITLIST_ALLOWED_ORIGINS=https://your-domain.example

# Rate limiting for POST /api/waitlist:
#   platform   - a durable limit is configured in front of the app (e.g. a Vercel Firewall rule)
#   memory-dev - in-memory limiter for local development only; refused when NODE_ENV=production
WAITLIST_RATE_LIMIT=
