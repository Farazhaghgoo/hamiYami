{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "hamiyami",
	// The Cloudflare account that holds the hamiyami.com zone (custom domains need the same account).
	"account_id": "6238aef0224c48ee73d9dfb95fd63796",
	"compatibility_date": "2026-10-19",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding; the service name must match the worker name.
			// See https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "hamiyami"
		}
	],
	"images": {
		// next/image optimization through Cloudflare Images.
		// See https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	// Cloudflare creates the DNS records and certificates for these on deploy.
	"routes": [
		{ "pattern": "hamiyami.com", "custom_domain": true },
		{ "pattern": "www.hamiyami.com", "custom_domain": true }
	],
	"vars": {
		"SITE_URL": "https://hamiyami.com"
	}
}
